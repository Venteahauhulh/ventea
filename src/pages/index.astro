---
import Base from '../layouts/Base.astro';
import SeatMap from '../components/SeatMap.astro';
import SaleSplit from '../components/SaleSplit.astro';
import { profile, experience, education, zin, lehkhabu } from '../data/profile';

const letters = profile.nickname.toUpperCase().split('');
const year = new Date().getFullYear();
---

<Base
  title={`${profile.name} (${profile.nickname}) — ${profile.role}, Aizawl`}
  description={`${profile.name} (${profile.nickname}), ${profile.role.toLowerCase()} in ${profile.location}.`}
>
  <header class="top wrap grid">
    <a href="/" class="t-name">{profile.name}</a>
    <span class="t-role">{profile.role}</span>
    <span class="t-loc">
      {profile.location}
      <span class="clock" data-tz={profile.timeZone}>&nbsp;</span>
    </span>
    <nav class="t-nav" aria-label="Sections">
      <a href="#work" class="u-link">Work</a>
      <a href="#experience" class="u-link">Experience</a>
      <a href="#contact" class="u-link">Contact</a>
      <button class="theme" type="button" aria-label="Toggle dark mode"><span></span></button>
    </nav>
  </header>

  <main>
    <section class="hero wrap" aria-labelledby="hero-name">
      <h1 id="hero-name" class="big" aria-label={profile.nickname}>
        {
          letters.map((l, i) => (
            <span class="m" aria-hidden="true">
              <span class="l" style={`--i:${i}`}>
                {l}
              </span>
            </span>
          ))
        }
      </h1>

      <div class="hero-meta grid">
        <p class="hm-a label">
          <span class="dot" aria-hidden="true"></span>{profile.level}
        </p>
        <p class="hm-b">
          {profile.name}, a {profile.role.toLowerCase().replace('&', 'and')} from {profile.region.split(',')[0]}.
          Currently building <a href="#zin" class="u-link">Zin</a>, a seat booking app for the Sumos that connect
          our towns, and <a href="#lehkhabu" class="u-link">Lehkhabu</a>, an app for Mizo ebooks and audiobooks.
        </p>
        <figure class="hm-c">
          <div class="ph">
            <img src={profile.photo} srcset={`/me/ventea-child-360.jpeg 360w, ${profile.photo} 640w`} sizes="(max-width: 860px) 260px, 25vw" alt={`${profile.nickname} as a small child, walking across a bridge in a yellow hoodie`} width="640" height="640" loading="eager" />
          </div>
          <figcaption>{profile.bio}</figcaption>
        </figure>
      </div>
    </section>

    <section id="work" class="sec" aria-labelledby="work-h">
      <div class="sec-head wrap grid rv">
        <span class="sec-n">01</span>
        <h2 id="work-h" class="sec-t">Work</h2>
        <span class="sec-c label">2 projects</span>
      </div>

      <article id="zin" class="proj zin" aria-label="Zin">
        <div class="wrap grid z-top">
          <div class="z-intro">
            <div class="z-title rv">
              <img src="/zin/logo.webp" alt="Zin app icon" width="88" height="88" class="z-logo" />
              <h3 class="z-name">Zin</h3>
            </div>
            <p class="z-line rv">{zin.line}</p>
            <p class="z-sum rv">{zin.summary}</p>
            <dl class="z-facts rv">
              {
                zin.facts.map(([k, v]) => (
                  <div>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <aside class="z-demo rv" aria-label="Seat map from the app">
            <p class="z-cap">A Sumo, from above. Same layout the app uses, same pilot fare.</p>
            <SeatMap />
            <ul class="z-routes">
              {
                zin.pilot.routes.map((r) => (
                  <li>
                    <span class="rt">
                      {r.from} <span aria-hidden="true">→</span>
                      <span class="sr-only">to</span> {r.to}
                    </span>
                    <span>{r.time}</span>
                    <span class="z-board">from {r.board}</span>
                  </li>
                ))
              }
            </ul>
            <p class="z-note">Pilot with {zin.pilot.operator}, one Sumo, daily. Times are set by the driver.</p>
          </aside>
        </div>

        <div class="wrap grid z-bottom">
          <div class="z-col z-built rv">
            <h4 class="z-h">What I built</h4>
            <ol>{zin.built.map((b) => <li>{b}</li>)}</ol>
          </div>
          <div class="z-col z-stack rv">
            <h4 class="z-h">Stack</h4>
            <dl>
              {
                zin.stack.map(([k, v]) => (
                  <div>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
          <div class="z-col z-rules rv">
            <h4 class="z-h">Booking rules</h4>
            <ul>{zin.rules.map((b) => <li>{b}</li>)}</ul>
          </div>
        </div>

        <div class="wrap z-stat rv">
          <span class="z-num">{zin.mergedPRs}</span>
          <span class="z-numl">merged pull requests, counted {zin.countedOn}</span>
        </div>
      </article>

      <article id="lehkhabu" class="proj lk" aria-label="Lehkhabu">
        <div class="wrap grid z-top">
          <div class="z-intro">
            <div class="z-title rv">
              <img src="/lehkhabu/logo.webp" alt="Lehkhabu app icon" width="88" height="88" class="z-logo" />
              <h3 class="z-name lk-name">{lehkhabu.name}</h3>
            </div>
            <p class="z-line rv">{lehkhabu.line}</p>
            <p class="z-sum rv">{lehkhabu.summary}</p>
            <dl class="z-facts rv">
              {
                lehkhabu.facts.map(([k, v]) => (
                  <div>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <aside class="z-demo rv" aria-label="Where the money from one sale goes">
            <p class="z-cap">Where one sale goes. Pick a price; the split uses the app’s own payout formula.</p>
            <SaleSplit />
            <p class="z-note">
              Default settings, adjustable by an admin. Earnings are held {lehkhabu.payout.holdDays} days, then paid
              out once a publisher’s balance reaches ₹{lehkhabu.payout.minPayout}.
            </p>
          </aside>
        </div>

        <div class="wrap grid z-bottom">
          <div class="z-col z-built rv">
            <h4 class="z-h">What I built</h4>
            <ol>{lehkhabu.built.map((b) => <li>{b}</li>)}</ol>
          </div>
          <div class="z-col z-stack rv">
            <h4 class="z-h">Stack</h4>
            <dl>
              {
                lehkhabu.stack.map(([k, v]) => (
                  <div>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
          <div class="z-col z-rules rv">
            <h4 class="z-h">Formats</h4>
            <dl class="lk-formats">
              {
                lehkhabu.formats.map(([k, v]) => (
                  <div>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))
              }
            </dl>
            <h4 class="z-h lk-wf-h">Book review</h4>
            <ol class="lk-wf">
              {lehkhabu.workflow.map((w) => <li>{w}</li>)}
            </ol>
            <p class="z-note">Rejected books go back to the publisher to edit and resubmit.</p>
          </div>
        </div>

        <div class="wrap z-stat rv">
          <span class="z-num">{lehkhabu.commits}</span>
          <span class="z-numl">commits, {lehkhabu.period}</span>
        </div>
      </article>
    </section>

    <section id="experience" class="sec" aria-labelledby="exp-h">
      <div class="sec-head wrap grid rv">
        <span class="sec-n">02</span>
        <h2 id="exp-h" class="sec-t">Experience</h2>
        <span class="sec-c label">{experience.length} roles</span>
      </div>
      <ol class="rows wrap">
        {
          experience.map((e) => (
            <li class="row grid rv">
              <span class="r-period label">{e.period ?? ''}</span>
              <div class="r-main">
                <h3 class="r-role">{e.role}</h3>
                <p class="r-org">
                  {e.org}
                  {e.place && <span class="r-place">, {e.place}</span>}
                </p>
                {e.note && <p class="r-note label">{e.note}</p>}
              </div>
              {e.points && (
                <ul class="r-points">
                  {e.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section id="education" class="sec" aria-labelledby="edu-h">
      <div class="sec-head wrap grid rv">
        <span class="sec-n">03</span>
        <h2 id="edu-h" class="sec-t">Education</h2>
      </div>
      <ol class="rows wrap">
        <li class="row grid rv">
          <span class="r-period label">{education.period ?? ''}</span>
          <div class="r-main">
            <h3 class="r-role">{education.role}</h3>
            <p class="r-org">
              {education.org}<span class="r-place">, {education.place}</span>
            </p>
          </div>
          <p class="r-points r-grade">{education.note}</p>
        </li>
      </ol>
    </section>

    <section id="contact" class="sec contact" aria-labelledby="ct-h">
      <div class="sec-head wrap grid rv">
        <span class="sec-n">04</span>
        <h2 id="ct-h" class="sec-t">Contact</h2>
      </div>
      <div class="wrap">
        <a class="ct-big rv" href={profile.email ? `mailto:${profile.email}` : profile.github} rel="me">
          <span class="ct-line">Let’s build</span>
          <span class="ct-line">something<span class="ct-arrow" aria-hidden="true">↗</span></span>
        </a>
        <div class="ct-links grid rv">
          {profile.email && <a href={`mailto:${profile.email}`} class="u-link">{profile.email}</a>}
          <a href={profile.github} class="u-link" rel="me">github.com/{profile.githubHandle}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot wrap grid">
    <span>© {year} {profile.name}</span>
    <span class="f-mid">Built from scratch with Astro.</span>
    <a href="#hero-name" class="u-link f-top">Back to top</a>
  </footer>
</Base>

<style>
  /* ---------- Top bar ---------- */
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    padding-block: 14px;
    font-size: var(--step--1);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
    align-items: center;
  }
  .top.scrolled {
    border-color: var(--line);
  }
  .t-name {
    grid-column: 1 / span 3;
    font-weight: 600;
  }
  .t-role {
    grid-column: 4 / span 3;
    color: var(--ink-2);
  }
  .t-loc {
    grid-column: 7 / span 3;
    color: var(--ink-2);
  }
  .clock {
    margin-left: 0.6em;
    color: var(--ink);
  }
  .t-nav {
    grid-column: 10 / span 3;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 18px;
  }
  .theme {
    width: 18px;
    height: 18px;
    padding: 0;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    overflow: hidden;
  }
  .theme span {
    display: block;
    width: 50%;
    height: 100%;
    background: var(--ink);
  }
  @media (max-width: 860px) {
    .t-role,
    .t-loc {
      display: none;
    }
    .t-name {
      grid-column: 1 / span 6;
    }
    .t-nav {
      grid-column: 7 / span 6;
      gap: 14px;
    }
    .t-nav a:not([href='#contact']) {
      display: none;
    }
  }

  /* ---------- Hero ---------- */
  .hero {
    min-height: min(calc(100svh - 52px), 1000px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: clamp(32px, 8vh, 96px);
    padding-bottom: clamp(32px, 6vh, 72px);
  }
  @media (max-width: 860px) {
    .hero {
      min-height: 0;
    }
  }
  .big {
    display: flex;
    justify-content: space-between;
    font-size: 23.4vw; /* corrected by fit script */
    line-height: 0.8;
    font-weight: 820;
    font-variation-settings: 'wdth' 125;
    white-space: nowrap;
  }
  .m {
    display: inline-block;
    clip-path: inset(0 -0.5em);
    padding-block: 0.04em;
  }
  .l {
    display: inline-block;
    transform: translateY(105%);
    animation: up 1.1s var(--ease) forwards;
    animation-delay: calc(0.15s + var(--i) * 0.06s);
  }
  .no-js .l {
    transform: none;
    animation: none;
  }
  @keyframes up {
    to {
      transform: none;
    }
  }

  .hero-meta {
    margin-top: clamp(28px, 4vw, 56px);
    padding-top: 16px;
    border-top: 1px solid var(--ink);
    row-gap: 20px;
    opacity: 0;
    animation: fade 1s var(--ease) 0.7s forwards;
  }
  .no-js .hero-meta {
    opacity: 1;
    animation: none;
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }
  .hm-a {
    grid-column: 1 / span 3;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
    transform: translateY(-1px);
  }
  .hm-b {
    grid-column: 4 / span 6;
    font-size: var(--step-1);
    line-height: 1.25;
    text-wrap: pretty;
  }
  .hm-c {
    grid-column: 10 / span 3;
    margin: 0;
    color: var(--ink-2);
  }
  .ph {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--line);
    margin-bottom: 12px;
  }
  .ph img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 40%;
    transform: scale(1.04);
    transition: transform 1.2s var(--ease);
  }
  .hm-c:hover .ph img {
    transform: scale(1.12);
  }
  @media (max-width: 860px) {
    .hm-a,
    .hm-b,
    .hm-c {
      grid-column: 1 / -1;
    }
    .hm-c {
      max-width: 260px;
    }
  }

  /* ---------- Section heads ---------- */
  .sec {
    padding-top: clamp(64px, 12vw, 160px);
  }
  .sec-head {
    margin-inline: var(--gutter);
    padding-inline: 0;
    align-items: end;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--ink);
    margin-bottom: clamp(28px, 4vw, 56px);
  }
  .sec-n {
    grid-column: 1 / span 3;
    font-size: var(--step--1);
    color: var(--accent-text);
    font-weight: 600;
  }
  .sec-t {
    grid-column: 4 / span 6;
    font-size: var(--step-3);
    line-height: 0.9;
    font-weight: 760;
    font-variation-settings: 'wdth' 112;
    letter-spacing: -0.03em;
  }
  .sec-c {
    grid-column: 10 / span 3;
    text-align: right;
  }
  @media (max-width: 860px) {
    .sec-n {
      grid-column: 1 / span 12;
      margin-bottom: 8px;
    }
    .sec-t {
      grid-column: 1 / span 8;
    }
    .sec-c {
      grid-column: 9 / span 4;
    }
  }

  /* ---------- Zin ---------- */
  .zin {
    --p-bg: var(--zin);
    --p-ink: var(--zin-ink);
    --p-ink-2: rgb(17 17 16 / 0.66);
    --p-line: var(--p-line);
  }
  .lk {
    --p-bg: #385ce0;
    --p-ink: #ffffff;
    --p-ink-2: rgb(255 255 255 / 0.84);
    --p-line: rgb(255 255 255 / 0.3);
  }
  .proj {
    --ink: var(--p-ink);
    --ink-2: var(--p-ink-2);
    background: var(--p-bg);
    color: var(--p-ink);
    padding-block: clamp(36px, 6vw, 88px);
  }
  .proj ::selection {
    background: var(--p-ink);
    color: var(--p-bg);
  }
  .z-top {
    row-gap: 48px;
  }
  .z-intro {
    grid-column: 1 / span 7;
  }
  .z-title {
    display: flex;
    align-items: flex-end;
    gap: clamp(14px, 2vw, 28px);
  }
  .z-logo {
    width: clamp(56px, 7vw, 96px);
    height: auto;
    border-radius: 22%;
    outline: 1.5px solid var(--p-ink);
    margin-bottom: 0.9vw;
  }
  .z-name {
    font-size: clamp(5rem, 16vw, 15rem);
    line-height: 0.78;
    font-weight: 850;
    font-variation-settings: 'wdth' 125;
    letter-spacing: -0.05em;
  }
  /* "Lehkhabu" is 8 letters: sized so it fits beside the icon in its column. */
  .lk-name {
    font-size: 7.4vw;
    letter-spacing: -0.04em;
  }
  @media (max-width: 960px) {
    .lk-name {
      /* width left after the page gutters and the icon, shared by 8 wide letters */
      font-size: calc((100vw - 2 * var(--gutter) - 100px) / 6);
    }
  }
  .lk-formats > div {
    padding-block: 7px;
    border-bottom: 1px solid var(--p-line);
  }
  .lk-formats dt {
    color: var(--p-ink);
    font-weight: 600;
    font-size: var(--step-0);
  }
  .lk-formats dd {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .z-h.lk-wf-h {
    margin-top: 28px;
  }
  .lk-wf {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 0;
    font-weight: 600;
  }
  .lk-wf li + li::before {
    content: '→';
    margin-inline: 8px;
    font-weight: 400;
  }
  .z-line {
    margin-top: clamp(20px, 3vw, 40px);
    font-size: var(--step-2);
    line-height: 1.05;
    font-weight: 650;
    font-variation-settings: 'wdth' 108;
    letter-spacing: -0.02em;
    max-width: 16ch;
  }
  .z-sum {
    margin-top: 20px;
    max-width: 52ch;
    font-size: var(--step-0);
  }
  .z-facts {
    margin-top: clamp(28px, 4vw, 48px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1.5px solid var(--p-ink);
    max-width: 640px;
  }
  .z-facts > div {
    padding: 12px 16px 12px 0;
    border-bottom: 1px solid var(--p-line);
  }
  dt {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .z-facts dd {
    font-weight: 560;
  }

  .z-demo {
    grid-column: 9 / span 4;
    align-self: start;
  }
  .z-cap,
  .z-note {
    font-size: var(--step--1);
    color: var(--ink-2);
    max-width: 34ch;
  }
  .z-cap {
    margin-bottom: 18px;
  }
  .z-routes {
    margin-top: 28px;
    border-top: 1.5px solid var(--p-ink);
  }
  .z-routes li {
    display: grid;
    grid-template-columns: 1fr auto;
    padding-block: 10px;
    border-bottom: 1px solid var(--p-line);
  }
  .rt {
    font-weight: 650;
  }
  .z-board {
    grid-column: 1 / -1;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .z-note {
    margin-top: 10px;
  }

  .z-bottom {
    margin-top: clamp(56px, 8vw, 112px);
    row-gap: 40px;
  }
  .z-col {
    border-top: 1.5px solid var(--p-ink);
    padding-top: 14px;
  }
  .z-built {
    grid-column: 1 / span 5;
  }
  .z-stack {
    grid-column: 6 / span 4;
  }
  .z-rules {
    grid-column: 10 / span 3;
  }
  .z-h {
    margin: 0 0 16px;
    font-size: var(--step--1);
    font-weight: 600;
  }
  .z-built ol {
    counter-reset: b;
  }
  .z-built li {
    counter-increment: b;
    display: grid;
    grid-template-columns: 2.2em 1fr;
    padding-block: 7px;
  }
  .z-built li::before {
    content: counter(b, decimal-leading-zero);
    font-size: var(--step--1);
    color: var(--ink-2);
    padding-top: 0.15em;
  }
  .z-stack dl > div {
    padding-bottom: 12px;
  }
  .z-rules li {
    padding-block: 7px;
    border-bottom: 1px solid var(--p-line);
  }
  .z-stat {
    margin-top: clamp(48px, 7vw, 96px);
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }
  .z-num {
    font-size: var(--step-3);
    font-weight: 820;
    font-variation-settings: 'wdth' 125;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  .z-numl {
    color: var(--ink-2);
  }
  @media (max-width: 960px) {
    .z-intro,
    .z-demo,
    .z-built,
    .z-stack,
    .z-rules {
      grid-column: 1 / -1;
    }
  }

  /* ---------- Rows (experience / education) ---------- */
  .row {
    padding-block: clamp(20px, 2.6vw, 32px);
    border-bottom: 1px solid var(--line);
    row-gap: 12px;
    transition: background 0.3s;
  }
  .r-period {
    grid-column: 1 / span 3;
    padding-top: 0.5em;
  }
  .r-main {
    grid-column: 4 / span 5;
  }
  .r-role {
    font-size: var(--step-1);
    line-height: 1.15;
    font-weight: 650;
    font-variation-settings: 'wdth' 108;
    letter-spacing: -0.01em;
  }
  .r-org {
    margin-top: 4px;
  }
  .r-place {
    color: var(--ink-2);
  }
  .r-note {
    margin-top: 6px;
  }
  .r-points {
    grid-column: 9 / span 4;
    color: var(--ink-2);
    padding-top: 0.35em;
  }
  .r-points li + li {
    margin-top: 4px;
  }
  .r-points li::before {
    content: '— ';
    color: var(--accent-text);
  }
  .r-grade {
    color: var(--ink);
    font-weight: 600;
  }
  @media (max-width: 860px) {
    .r-period,
    .r-main,
    .r-points {
      grid-column: 1 / -1;
      padding-top: 0;
    }
    .r-period:empty {
      display: none;
