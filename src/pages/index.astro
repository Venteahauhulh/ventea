  /* ---------- Contact ---------- */
  .ct-big {
    display: block;
    font-size: clamp(3rem, 11.5vw, 13rem);
    line-height: 0.86;
    font-weight: 820;
    font-variation-settings: 'wdth' 118;
    letter-spacing: -0.045em;
  }
  .ct-line {
    display: block;
    transition: transform 0.6s var(--ease);
  }
  .ct-big:hover .ct-line:last-child {
