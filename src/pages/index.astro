</style>

<script>
  // Fit the hero name exactly to the column width.
  const big = document.querySelector<HTMLElement>('.big');
  const fit = () => {
    if (!big) return;
    big.style.fontSize = '100px';
    big.style.justifyContent = 'flex-start';
    const inner = [...big.children].reduce((w, el) => w + (el as HTMLElement).offsetWidth, 0);
    const avail = big.clientWidth * 0.995;
    big.style.fontSize = `${(100 * avail) / inner}px`;
    big.style.justifyContent = '';
  };
  document.fonts.ready.then(fit);
  fit();
  addEventListener('resize', fit);

  // Live time in Aizawl.
  const clock = document.querySelector<HTMLElement>('.clock');
  if (clock) {
    const f = new Intl.DateTimeFormat('en-GB', {
      timeZone: clock.dataset.tz,
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
    });
    const tick = () => (clock.textContent = `${f.format(new Date())} IST`);
    tick();
    setInterval(tick, 1000);
  }

  // Top bar hairline after scrolling.
  const top = document.querySelector('.top')!;
  const onScroll = () => top.classList.toggle('scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Reveal on scroll.
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }),
    { rootMargin: '0px 0px -8% 0px' }
  );
  document.querySelectorAll('.rv').forEach((el) => io.observe(el));

  // Theme toggle.
  const root = document.documentElement;
  document.querySelector('.theme')?.addEventListener('click', () => {
    const dark =
      root.dataset.theme === 'dark' ||
      (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    root.dataset.theme = dark ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', root.dataset.theme);
    } catch {}
  });
</script>
